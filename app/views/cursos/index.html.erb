<nav>
    <div>
        <h1>Todos os Cursos</h1>
        <% if policy(@curso).create? %>
            <%= render OpenModalButton::OpenModalButtonComponent.new(
                href: new_curso_path,
                button_class: 'open-modal-curso',
                tooltip: 'Adicionar curso',
                open_modal: false)
            %>
        <% end %>
        <%= render @cursos %>
    </div>
</nav>