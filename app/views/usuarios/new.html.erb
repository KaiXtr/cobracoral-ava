<%= form_with(model: @usuario) do |f| %>
    <div class="inicio-banner">
        <div class="usuario-banner-icon photo-upload" tooltip-text="Enviar foto">
            <i class="fa-solid fa-camera fa-lg"></i>
            <%= f.file_field :avatar %>
        </div>
    </div>
    <nav>
        <h1>Cadastrar usuário</h1>
        <div class="form_group">
            <%= f.label :cargo_usuario, "Cargo" %>
            <div class="select-box">
                <%= f.select :cargo_usuario,
                    options_for_select(select_cargo_usuario(), @usuario.cargo_usuario)
                %>
            </div>
        </div>
        <div class="form_group">
            <%= f.label :pronomes_usuario, "Pronomes" %>
            <div class="select-box">
                <%= f.select :pronomes_usuario,
                    options_for_select(select_pronomes(), @usuario.pronomes_usuario)
                %>
            </div>
        </div>
        <div class="form_group">
            <%= f.label :nome_completo, 'Nome completo' %>
            <%= f.text_field :nome_completo, class: 'input-text' %>
        </div>
        <div class="form_group">
            <%= f.label :email, 'Email institucional' %>
            <%= f.email_field :email, class: 'input-text' %>
        </div>
        <div class="form_group">
            <%= f.label :telefone, 'Telefone' %>
            <%= f.text_field :telefone, class: 'input-text' %>
        </div>

        <%= render CancelarSalvarButtonsComponent.new(
            cancel_to_link: '/usuarios/' + @usuario.id.to_s)
        %>
    </nav>
<% end %>
