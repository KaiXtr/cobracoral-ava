<nav>
  <div class="deslizar-transition">
    <a href="/disciplinas/<%= @disciplina_conteudo.id %>" class="goback-button">
      <i class="fa-solid fa-arrow-left fa-sm"></i>
      Voltar para <strong><%= @disciplina_conteudo.nome_disciplina %></strong>
    </a>
    <h1>
      <%= @conteudo.nome_conteudo %>
      <% if policy(@conteudo).edit? %>
        <a href="/conteudos/<%= @conteudo.id %>/editar" tooltip-text="Editar conteúdo">
            <i class="fa-solid fa-pen fa-sm icon-button"></i>
        </a>
      <% end %>
    </h1>
    <span class="conteudo-data">
      <%= formatar_data_liberacao(@conteudo.data_liberacao) %>
    </span>
    <span class="conteudo-data">
      <%= formatar_data_vencimento(@conteudo.data_vencimento) %>
    </span>

    <div class="conteudo-elementos" id="content">
      <%= @conteudo.corpo %>
    </div>


    <div id="annotation-area">
      <textarea placeholder="Insira texto..." id="text-area-anotacao" ></textarea>
      <div id="anotacoes-paleta">
        <img src="/assets/pencil.png" />
          <div class="paleta-circle" style="background-color: red;"></div>
          <div class="paleta-circle" style="background-color: orange;"></div>
          <div class="paleta-circle" style="background-color: yellow;"></div>
          <div class="paleta-circle" style="background-color: green;"></div>
          <div class="paleta-circle" style="background-color: cyan;"></div>
          <div class="paleta-circle" style="background-color: darkblue;"></div>
          <div class="paleta-circle" style="background-color: purple;"></div>
          <div class="paleta-circle" style="background-color: pink;"></div>
          <div class="paleta-circle" style="background-color: white;"></div>
      </div>
    </div>
    
    <%= render ConteudoNavButtonComponent.new(
      conteudoAtual: @conteudo,
      proximoConteudo: @proximoConteudo)
    %>
  </div>
</nav>

<script>
  const content = document.getElementById('content')
  const anottationArea = document.getElementById('annotation-area')
  const range = null;

  content.addEventListener('mouseup', (event) => {
    const selection = window.getSelection();

    const selectedText = selection?.toString();
    console.log('Texto selecionado:', selectedText);
    
    if(selection && !selection.isCollapsed && content.contains(selection.anchorNode)){
      anottationArea.classList.add('visible');
    }
  })

  document.addEventListener('mouseup', (event) => {
    const clickedElement = event.target;
  })

</script>