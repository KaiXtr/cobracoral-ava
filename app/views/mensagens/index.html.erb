<nav class="mensagens-nav">
  <div class="mensagens-users">
    <% for u in @mensagens_usuarios %>
      <div class="mensagens-users-button">
        <a href="/mensagens/<%= u.id %>">
          <%= u.nome_completo %>
        </a>
      </div>
    <% end %>
  </div>
  <div class="mensagens-user">
    <div class="mensagens-list">
      <% @mensagens.each do |mensagem| %>
        <%= render mensagem %>
      <% end %>
    </div>
    <% if @usuario_destinatario %>
      <div class="mensagem-input-form">
        <%= form_for Mensagem.new,
          url: '/mensagens/' + @usuario_destinatario,
          html: { method: :post } do |form| %>
          <%= form.rich_text_area :corpo %>
          <button type="submit">
            <i class="fa-solid fa-paper-plane fa-xl icon-button"></i>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>
</nav>
