<%= render CobraModalComponent.new() do %>
    <h2>Deseja realmente apagar este comunicado?</h2>
    <p>
        Não será possível desfazer as alterações.
    </p>
    <%= render CancelarSalvarButtonsComponent.new(
        submit_text: 'Deletar',
        submit_to_link: '/comunicados/' + @comunicado.id.to_s + '/destroy',
        close_modal: true)
    %>
<% end %>
