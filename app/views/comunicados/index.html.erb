<nav>
  <div class="deslizar-transition">
    <h1>Comunicados</h1>
    <% if @comunicados %>
      <% if policy(@comunicado).new? %>
        <%= render OpenModalButtonComponent.new(
          href: new_comunicado_path,
          button_class: 'open-modal-comunicado',
          tooltip: 'Criar comunicado')
        %>
      <% end %>
      <%= turbo_stream_from "comunicados" %>
      <div>
        <%= render @comunicados %>
      </div>
    <% else %>
      <p>
        Você está em dia.
      </p>
    <% end %>
  </div>
</nav>
