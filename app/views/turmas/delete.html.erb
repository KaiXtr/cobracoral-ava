<%= render CobraModalComponent.new() do %>
    <h2>Deseja realmente apagar a turma <%= @turma.nome_turma %>?</h2>
    <p>
        Não será possível desfazer as alterações.
    </p>
    <%= render CancelarSalvarButtonsComponent.new(
        submit_text: 'Deletar',
        submit_to_link: '/turmas/' + @turma.id.to_s + '/destroy',
        close_modal: true)
    %>
<% end %>
