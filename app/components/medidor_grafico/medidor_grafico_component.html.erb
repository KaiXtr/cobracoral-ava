<div class="medidor-container">
    <div class="medidor-grafico">
        <div class="medidor-grafico-atual"
            style="<%= @medidor_style %>">
            <progress
                value="<%= @valor_entrada %>"
                min="0"
                max="<%= @valor_max %>"
                style="visibility:hidden;height:0;width:0;">
                <%= @label_entrada %>
            </progress>
        </div>
        <div class="medidor-grafico-max"></div>
        <span class="medidor-grafico-valor">
            <%= @label_entrada %>
        </span>
    </div>
    <% if @medidor_titulo != nil %>
        <h5>
            <%= @medidor_titulo %>
            <% if @modal_href && @is_link_enabled %>
                <a
                    href="<%= @modal_href %>"
                    tooltip-text="Abrir gráfico"
                    data-turbo-frame="cobra-modal"
                    data-remote="true">
                    <i class="fa-solid fa-pie-chart fa-lg icon-button"></i>
                </a>
            <% end %>
        </h5>
    <% end %>
</div>
