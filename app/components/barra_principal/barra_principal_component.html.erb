<header id="cobracoral-header" class="header-compacto">
    <button class="icon-button"
        id="header-open-nav-component"
        onclick="abrirBarraLateral()"
        tooltip-text="Menu de navegação"
        aria-label="Abrir menu de navegação lateral">
        <i class="fa-solid fa-bars fa-2xl"></i>
    </button>
    <div class="header-logo">
    <div class="header-logo-svg" alt="Logotipo">
        <%= helpers.show_svg('cobracoral-logo.svg') %>
    </div>
    <div class="header-logo-info">
        <a href="/" aria-label="Início">
            <h1>
                <% if helpers.current_curso(@usuario_autenticado) %>
                    <%= helpers.current_curso(@usuario_autenticado).nome_curso %>
                <% else %>
                    Cobracoral
                <% end %>
            </h1>
        </a>
        <span>
            Instituto Cobracoral
        </span>
    </div>
    </div>
    <ul id="header-buttons">
        <li>
            <a href="/comunicados"
                class="icon-button"
                tooltip-text="Comunicados"
                aria-label="<%=
                    @novos_comunicados > 0 ? "#{@novos_comunicados} novos " : ''
                    %> Comunicados">
                <i class="fa-solid fa-bell fa-2xl"></i>
                <% if @novos_comunicados > 0 %>
                    <span class="icon-button-counter">
                        <%= @novos_comunicados %>
                    </span>
                <% end %>
            </a>
        </li>
        <li>
            <a href="/cursos"
                class="icon-button"
                tooltip-text="Cursos"
                aria-label="Cursos">
                <i class="fa-solid fa-book-open fa-2xl"></i>
            </a>
        </li>
        <li>
            <a href="/tarefas"
                class="icon-button"
                tooltip-text="Tarefas"
                aria-label="Tarefas">
                <i class="fa-solid fa-list-check fa-2xl"></i>
            </a>
        </li>
        <li>
            <a href="/agendamentos"
                class="icon-button"
                tooltip-text="Calendário"
                aria-label="Agendamentos">
                <i class="fa-solid fa-calendar fa-2xl"></i>
            </a>
        </li>
        <li>
            <a href="/mensagens"
                class="icon-button"
                tooltip-text="Mensagens"
                aria-label="<%=
                    @novas_mensagens > 0 ? "#{@novas_mensagens} novas " : ''
                    %> Mensagens">
                <i class="fa-solid fa-comment fa-2xl"></i>
                <% if @novas_mensagens > 0 %>
                    <span class="icon-button-counter">
                        <%= @novas_mensagens %>
                    </span>
                <% end %>
            </a>
        </li>
        <li>
            <button class="icon-button abrir-menu"
                onclick="abrirMenuPerfil()"
                aria-label="Perfil">
                <i class="fa-solid fa-user fa-2xl"></i>
                <%= render MenuPerfil::MenuPerfilComponent.new(usuario_autenticado: @usuario_autenticado) %>
            </button>
        </li>
    </ul>
</header>
<% if @cobra_app_resting %>
    <div id="cobra-app-resting-bar">
        <h2>Hora de uma pausa.</h2>
        <span>Retorne dentro de <%= @pomodoro_tempo_descanso %> minutos.</span>
    </div>
<% end %>
<div id="cobracoral-header-spacing">
</div>
