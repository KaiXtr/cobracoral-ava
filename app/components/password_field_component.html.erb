<%= @form.password_field @val,
    placeholder: @placeholder,
    id: @id,
    class: 'input-text',
    required: 'true'
%>
<button id="<%= @id %>-eye-button" type="button" class="password-field-button">
    <i class="fa-solid fa-eye"></i>
</button>
<script type="text/javascript">
    let passwordButton = document.getElementById('<%= @id %>-eye-button');
    passwordButton.addEventListener('click', function() {
        let passwordField = document.getElementById('<%= @id %>');
        if (passwordField.type == "password") {
            passwordField.type = "text";
            passwordButton.firstElementChild.classList.add('fa-eye-slash');
            passwordButton.firstElementChild.classList.remove('fa-eye');
        } else {
            passwordField.type = "password";
            passwordButton.firstElementChild.classList.add('fa-eye');
            passwordButton.firstElementChild.classList.remove('fa-eye-slash');
        }
    });
</script>
