<%= turbo_frame_tag "cobra-modal" do %>
    <div id="cobra-modal-background"></div>
    <%= tag.div data: {
            controller: @modal_controller,
            turbo_modal_target: @modal_target,
            action: @modal_actions,
            allow_close_background: @allow_close_background
        }, class: "modal-transition-in",
        role: "dialog" do %>
        <%= content %>
    <% end %>
<% end %>
