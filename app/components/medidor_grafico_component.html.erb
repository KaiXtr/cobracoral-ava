<div class="medidor-container">
    <div class="medidor-grafico">
        <div class="medidor-grafico-max"></div>
        <div class="medidor-grafico-atual"></div>
        <span class="medidor-grafico-valor"><%= @valor_entrada %></span>
    </div>
    <h5>
        <%= @medidor_titulo %>
        <% if @modal_href %>
            <a
                href="<%= @modal_href %>"
                tooltip-text="Abrir gráfico"
                data-turbo-frame="cobra-modal"
                data-remote="true">
                <i class="fa-solid fa-pie-chart fa-lg icon-button"></i>
            </a>
        <% end %>
    </h5>
</div>
