<% if @href && @href != nil %>
    <a href="<%= @href %>" tabindex="-1">
<% end %>

<button
    type="<%= @type %>"
    class="cobra-button"
    <% if @id %>
        id="<%= @id %>"
    <% end %>
    <% if @onclick %>
        onclick="<%= @onclick %>"
    <% end %>
    <% if @data_action %>
        data-action="<%= @data_action %>"
    <% end %>
    <% if @enable_turbo %>
        data-turbo-prefetch="true"
    <% end %>
>
    <%= @text %>
</button>

<% if @href && @href != nil %>
    </a>
<% end %>
